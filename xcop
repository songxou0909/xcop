def open_input_window_topaz():
    global last_topaz_inputs
    input_window = QWidget()
    input_window.setWindowTitle("Enter Parameters for Check Topaz Training")
    center_window(input_window, 400, 250, "topaz_training")
    toplevel_windows.append(input_window)
    if 'app' in globals() and app:
        input_window.setStyleSheet(app.styleSheet())
    
    layout = QGridLayout(input_window)
    layout.addWidget(QLabel("Job Number:"), 0, 0)
    
    entry = QLineEdit()
    if last_topaz_inputs:
        entry.setText(last_topaz_inputs[0])
    layout.addWidget(entry, 0, 1)

    def submit_inputs():
        global last_topaz_inputs
        job_number = entry.text().strip() or "param1"
        if not job_number.isdigit():
            show_error_message("Job Number must be a numeric value (e.g., 001)")
            return
        
        # This safely pads 1 or 2 digits with leading zeros, but leaves 4+ digits alone.
        job_number = job_number.zfill(3)
        
        last_topaz_inputs = [job_number]
        save_last_inputs()
        
        command = f"cat AutoPick/job{job_number}/model_training.txt | grep test"
        final_output = ""
        write_to_log(command)
        try:
            output = subprocess.check_output(command, shell=True, text=True, stderr=subprocess.STDOUT)
            output_lines = output.splitlines()
            formatted_output = []
            max_value = float('-inf')
            max_epoch = None
            
            for line in output_lines:
                columns = line.split()
                if columns:
                    first_column = columns[0]
                    last_column = columns[-1]
                    try:
                        value = float(last_column)
                        if value > max_value:
                            max_value = value
                            max_epoch = first_column
                    except ValueError:
                        continue
                    formatted_output.append(f"epoch{first_column}\t\t{last_column}")

            header = f"epoch {max_epoch} has the best training result\n\n" if max_epoch is not None else "No valid data found.\n"
            final_output = header + "\n".join(formatted_output)
            
        except subprocess.CalledProcessError:
            if 'app' in globals() and app:
                app.output_text.setText(f"Command failed: please check your job number")
            close_toplevel_windows()
            return
        
        if 'app' in globals() and app:
            app.output_text.setText(final_output)
        close_toplevel_windows()

    btn_grep = QPushButton("Grep Test")
    btn_grep.clicked.connect(submit_inputs)
    layout.addWidget(btn_grep, 1, 0, 1, 2)
    
    input_window.show()

# Functions for Movie Frames logic
def get_first_eer_file(folder_path='./Movies'):
    try:
        if not os.path.exists(folder_path):
            return None
        
        # Look for the first .eer file in the specified directory
        for f in os.listdir(folder_path):
            if f.lower().endswith('.eer'):
                return f
                
        return None
    except Exception:
        return None

def get_number_of_frames(filename, folder_path='./Movies'):
    try:
        filepath = os.path.join(folder_path, filename)
        
        # Read the first 256 bytes directly in Python
        with open(filepath, 'rb') as f:
            binary_data = f.read(256)
        
        text_part = binary_data.decode('utf-8', errors='ignore')

        match = re.search(r'frameID">\s*(\d+)', text_part)
        if match:
            frame_id = int(match.group(1))
            return str(frame_id + 1)
        else:
            return None
    except Exception:
        return None

def get_movie_frames():
    global last_movie_frames

    # 1. Ask user for the directory containing .eer files
    # Pass None as parent to detach the window and prevent X11 focus deadlocks
    folder_path = QFileDialog.getExistingDirectory(
        None, 
        "Select Folder Containing .eer Files", 
        os.getcwd()
    )
    
    if not folder_path:
        return  # User cancelled the dialog

    try:
        # 2. Get the file from the chosen directory
        file_name = get_first_eer_file(folder_path)
        
        if not file_name:
            if 'app' in globals() and app:
                app.output_text.setText(f"Error: No .eer file found in {os.path.basename(folder_path)}.")
            return

        # 3. Get the frames
        frames = get_number_of_frames(file_name, folder_path)

        if frames:
            last_movie_frames = frames

            # 4. Update UI directly (No QTimer needed, just like xmipp)
            if 'app' in globals() and app:
                # Try setPlainText first, falling back to setText if needed
                if hasattr(app.output_text, 'setPlainText'):
                    app.output_text.setPlainText(f"Number of frames: {frames}")
                else:
                    app.output_text.setText(f"Number of frames: {frames}")
            
            if 'save_last_inputs' in globals():
                save_last_inputs()
        else:
            if 'app' in globals() and app:
                app.output_text.setText("Error: Could not read frame count from the selected file.")

    except Exception as e:
        if 'app' in globals() and app:
            app.output_text.setText(f"Crash: {str(e)}")

def open_new_gain_file():
    # 1. Ask user where to save the file
    current_dir = os.getcwd()
    file_path, _ = QFileDialog.getSaveFileName(
        None, 
        "Save New Gain File", 
        os.path.join(current_dir, "Gain_relion_estimated.mrc"), 
        "MRC files (*.mrc);;All files (*.*)"
    )

    if not file_path:
        return

    # 2. Calculate the relative path from current working directory
    # If the user selected a file inside the current project folder, this makes it relative.
    # If it's outside, relpath handles that too (though usually less clean).
    try:
        relative_path = os.path.relpath(file_path, current_dir)
    except ValueError:
        # Fallback for Windows if drives are different
        relative_path = file_path

    # 3. Get frame count (Reusing existing logic)
    # We must ensure we have a valid EER file to check frames
    eer_file = get_first_eer_file()
    
    if not eer_file:
        if 'app' in globals() and app:
            app.output_text.setText("Error: No .eer file found in ./Movies to calculate frames.")
        return

    frames_str = get_number_of_frames(eer_file)
    
    if not frames_str:
        if 'app' in globals() and app:
            app.output_text.setText("Error: Could not read frame count from EER file.")
        return

    try:
        # 4. Calculate max frames (frames * 1000)
        num_frames = int(frames_str)
        max_frames_val = num_frames * 1000
        
        # 5. Construct Command
        command = (
            f"module load {RELION_VER} && srun -c 10 -p cpu relion_estimate_gain "
            f"--i Import/job001/movies.star "
            f"--o {relative_path} "
            f"--dont_invert --max_frames {max_frames_val} &"
        )
        
        write_to_log(command)

        # 6. Execute
        subprocess.Popen(command, shell=True, executable="/bin/bash")
        
        if 'app' in globals() and app:
            app.output_text.setText(f"Command Sent\n\nRunning...\n\nDetected Frames:{num_frames}\nPlease wait for Relion...")
            
    except ValueError:
        if 'app' in globals() and app:
            app.output_text.setText(f"Error: Invalid frame count detected ({frames_str}).")

