        def open_zoom_window(self, img_array, title):
            from PyQt6.QtWidgets import QWidget, QVBoxLayout, QGraphicsView, QGraphicsScene, QFrame
            from PyQt6.QtGui import QImage, QPixmap, QColor
            from PyQt6.QtCore import Qt
            import numpy as np
            
            class CustomZoomView(QGraphicsView):
                def __init__(self, parent=None):
                    super().__init__(parent)
                    # Setup sleek, borderless view
                    self.setTransformationAnchor(QGraphicsView.ViewportAnchor.AnchorUnderMouse)
                    self.setResizeAnchor(QGraphicsView.ViewportAnchor.AnchorUnderMouse)
                    self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
                    self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
                    self.setBackgroundBrush(QColor('#1e1e1e'))
                    self.setFrameShape(QFrame.Shape.NoFrame)
                    self.setDragMode(QGraphicsView.DragMode.NoDrag)
                    
                    self._is_panning = False
                    self._last_mouse_pos = None

                def wheelEvent(self, event):
                    # Smooth zooming with mouse wheel (Centers on cursor)
                    zoom_factor = 1.15 if event.angleDelta().y() > 0 else 1.0 / 1.15
                    self.scale(zoom_factor, zoom_factor)

                def mousePressEvent(self, event):
                    # Right click to start panning
                    if event.button() == Qt.MouseButton.RightButton:
                        self._is_panning = True
                        self._last_mouse_pos = event.position().toPoint()
                        self.setCursor(Qt.CursorShape.ClosedHandCursor)
                        event.accept()
                    else:
                        super().mousePressEvent(event)

                def mouseMoveEvent(self, event):
                    # Drag to pan
                    if self._is_panning:
                        delta = event.position().toPoint() - self._last_mouse_pos
                        self._last_mouse_pos = event.position().toPoint()
                        
                        self.horizontalScrollBar().setValue(self.horizontalScrollBar().value() - delta.x())
                        self.verticalScrollBar().setValue(self.verticalScrollBar().value() - delta.y())
                        event.accept()
                    else:
                        super().mouseMoveEvent(event)

                def mouseReleaseEvent(self, event):
                    # Stop panning on right click release
                    if event.button() == Qt.MouseButton.RightButton:
                        self._is_panning = False
                        self.setCursor(Qt.CursorShape.ArrowCursor)
                        event.accept()
                    else:
                        super().mouseReleaseEvent(event)

            zoom_win = QWidget()
            zoom_win.setWindowTitle(f"Preview: {title}")
            zoom_win.resize(700, 700)
            zoom_win.setStyleSheet("background-color: #1e1e1e;")
            
            global toplevel_windows
            toplevel_windows.append(zoom_win)
            
            layout = QVBoxLayout(zoom_win)
            layout.setContentsMargins(0, 0, 0, 0)
            
            # 1. Convert Numpy Float Array to 0-255 Grayscale Array
            img_min = np.min(img_array)
            img_max = np.max(img_array)
            if img_max > img_min:
                norm_img = (img_array - img_min) / (img_max - img_min) * 255
            else:
                norm_img = np.zeros_like(img_array)
                
            img_uint8 = np.require(norm_img.astype(np.uint8), np.uint8, 'C')
            
            # 2. Create QImage (must copy to prevent memory corruption)
            h, w = img_uint8.shape
            qimg = QImage(img_uint8.data, w, h, w, QImage.Format.Format_Grayscale8).copy()
            
            # 3. Setup Graphics Scene and View
            scene = QGraphicsScene()
            pixmap_item = scene.addPixmap(QPixmap.fromImage(qimg))
            
            view = CustomZoomView()
            view.setScene(scene)
            
            # 4. Auto-fit the image to the window initially
            view.fitInView(pixmap_item, Qt.AspectRatioMode.KeepAspectRatio)
            
            layout.addWidget(view)
            zoom_win.show()
            self._zoom_windows.append(zoom_win) # Keep reference alive
        
