    def read_spi_simple(filename):
        try:
            with open(filename, 'rb') as f:
                header = np.fromfile(f, dtype=np.float32, count=256)
                nrow = int(header[1])
                nsam = int(header[11])
                labbyt = int(header[21])
                f.seek(labbyt)
                data = np.fromfile(f, dtype=np.float32, count=nrow*nsam)
                return data.reshape((nrow, nsam))
        except Exception:
            return None

    class SpiCanvas(FigureCanvas):
        def __init__(self, parent=None, width=8, height=4, dpi=100):
            self.fig = Figure(figsize=(width, height), dpi=dpi)
            self.fig.patch.set_facecolor('#1e1e1e')
            
            # Absolute positioning, will be precisely recalculated in update_layout
            self.ax1 = self.fig.add_axes([0, 0, 1, 1])
            self.ax2 = self.fig.add_axes([0, 0, 1, 1])
            self.ax3 = self.fig.add_axes([0, 0, 1, 1])
            
            for ax in [self.ax1, self.ax2, self.ax3]:
                ax.set_facecolor('#1e1e1e')
                ax.axis('off')
                
            super(SpiCanvas, self).__init__(self.fig)
            self.setParent(parent)
            self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
            self.dim_label = None
            
            self.iteration_count = 0
            self.last_mtime = 0
            
            # Store intrinsic dimensions. Defaults roughly match standard Xmipp sizes.
            self.dim1 = (210, 210)  # w, h
            self.dim2 = (300, 172)
            self.dim3 = (300, 172)
            
            # Store image arrays for interactive click zooming
            self.img_data = {self.ax1: None, self.ax2: None, self.ax3: None}
            self.img_titles = {self.ax1: "rec.spi", self.ax2: "before_reproject.spi", self.ax3: "after_reproject.spi"}
            self.fig.canvas.mpl_connect('button_press_event', self.on_click)
            self._zoom_windows = []

        def update_layout(self, w_canvas=None, h_canvas=None):
            if w_canvas is None or h_canvas is None:
                w_canvas = self.width()
                h_canvas = self.height()
                
            if w_canvas <= 0 or h_canvas <= 0: return

            w1, h1 = self.dim1
            w2, h2 = self.dim2
            w3, h3 = self.dim3
            
            h1 = max(1, h1)
            h2 = max(1, h2)
            h3 = max(1, h3)
            
            gap_px = 5 
            
            # The right column stacks Image 2 on top of Image 3. 
            # We want their combined height to match the left image's height flawlessly.
            right_scale = h1 / (h2 + h3)
            right_width_rel = w2 * right_scale
            
            # Total intrinsic width and height of the perfectly proportioned combined block
            block_w_intrinsic = w1 + gap_px + right_width_rel
            block_h_intrinsic = h1
            
            block_aspect = block_w_intrinsic / block_h_intrinsic
            canvas_aspect = w_canvas / h_canvas
            
            margin = 10
            avail_w = w_canvas - 2 * margin
            avail_h = h_canvas - 2 * margin
            if avail_w <= 0 or avail_h <= 0: return
            
            # Scale block to fit the canvas strictly by its intrinsic aspect ratio
            if canvas_aspect > block_aspect:
                draw_h = avail_h
                draw_w = draw_h * block_aspect
            else:
                draw_w = avail_w
                draw_h = draw_w / block_aspect
                
            # Center the block (leaves edges empty rather than stretching)
            x_start = (w_canvas - draw_w) / 2
            y_start = (h_canvas - draw_h) / 2
            
            # Compute perfect normalized coordinates
            ax1_w_frac = w1 / block_w_intrinsic
            ax1_px_w = draw_w * ax1_w_frac
            gap_px_w = draw_w * (gap_px / block_w_intrinsic)
            
            ax1_x = x_start / w_canvas
            ax1_y = y_start / h_canvas
            ax1_w = ax1_px_w / w_canvas
            ax1_h = draw_h / h_canvas
            
            h2_frac = h2 / (h2 + h3)
            h3_frac = h3 / (h2 + h3)
            
            ax2_x = (x_start + ax1_px_w + gap_px_w) / w_canvas
            ax2_w = (draw_w - ax1_px_w - gap_px_w) / w_canvas
            ax2_h = (draw_h * h2_frac) / h_canvas
            ax2_y = (y_start + draw_h * h3_frac) / h_canvas
            
            ax3_x = ax2_x
            ax3_w = ax2_w
            ax3_h = (draw_h * h3_frac) / h_canvas
            ax3_y = ax1_y
            
            self.ax1.set_position([ax1_x, ax1_y, ax1_w, ax1_h])
            self.ax2.set_position([ax2_x, ax2_y, ax2_w, ax2_h])
            self.ax3.set_position([ax3_x, ax3_y, ax3_w, ax3_h])

        def resizeEvent(self, event):
            self.update_layout(event.size().width(), event.size().height())
            super(SpiCanvas, self).resizeEvent(event)
            
