                    QTimer.singleShot(2000, lambda: result_label.setText("") if result_label.text() == f"Copied: {text}" else None)
            return False # Allow the normal focus/cursor behavior to continue

    # Keep a reference to the filter to prevent garbage collection
    twist_window._copy_filter = CopyClickFilter(twist_window)
    
    # Apply the filter to all relevant input and range boxes
    copyable_entries = [
        entry_rise, entry_rise_min, entry_rise_max, 
        entry_crossover, entry_twist, entry_twist_min, entry_twist_max
    ]
    for entry in copyable_entries:
        entry.installEventFilter(twist_window._copy_filter)
        
    # Enable the built-in 'x' clear button for editable textboxes
    for entry in [job_entry, entry_rise, entry_crossover, entry_twist]:
        entry.setClearButtonEnabled(True)

    # HELPER: Format to max 5 decimals, no trailing zeros
    def fmt(val):
        return str(round(val, 5))

    def auto_fill_from_run_out(text):
        if not text.strip(): return
        
        j_str = text.strip()
        if j_str.isdigit():
            j_str = j_str.zfill(3)
        
        possible_paths = [
            f"Refine3D/job{j_str}/run.out"
        ]
        
        run_out_path = None
        for p in possible_paths:
            if os.path.exists(p):
                run_out_path = p
                break
                
        if not run_out_path:
            return
            
        try:
            import re
            found_twist, found_rise = None, None
            with open(run_out_path, 'r', encoding='utf-8') as f:
                lines = f.readlines()
                # Read backwards to get the latest (converged) iteration
                for line in reversed(lines):
                    line_lower = line.lower()
                    if 'twist' in line_lower and 'rise' in line_lower:
                        match_twist = re.search(r'twist.*?([-+]?\d*\.?\d+)', line_lower)
                        match_rise = re.search(r'rise.*?([-+]?\d*\.?\d+)', line_lower)
                        
                        if match_twist and match_rise:
                            found_twist = match_twist.group(1)
                            found_rise = match_rise.group(1)
                            break
                            
            if found_twist and found_rise:
                entry_twist.setText(found_twist)
                entry_rise.setText(found_rise)
                entry_crossover.clear() # Clear crossover so calculate() can auto-fill it
                
                t_val = float(found_twist)
                
                # Auto-toggle Left-handed box based on the twist value
                if t_val < 0:
                    check_left.setChecked(True)
                elif 0 <= t_val < 90:
                    check_left.setChecked(False)
                elif 90 <= t_val < 180:
                    check_left.setChecked(True)
                elif 180 <= t_val <= 270:
                    check_left.setChecked(False)
                else:
                    check_left.setChecked(False) # Fallback for > 270
                    
                # Auto-toggle C21 box based on the twist value
                if 90 <= t_val <= 270:
                    check_c21.setChecked(True)
                else:
                    check_c21.setChecked(False)
                    
                calculate() # Auto-calculate the crossover and update ranges
                result_label.setText(f"Auto-filled from job {j_str}")
                result_label.setStyleSheet("color: #98c379;")
        except Exception as e:
            pass

    job_entry.textChanged.connect(auto_fill_from_run_out)

    # HELPER: Only updates the range boxes (Safe to run anytime)
    def update_ranges():
        try:
            r_delta = float(combo_range.currentText())
            is_c21 = check_c21.isChecked()
            
            # Halve the delta for BOTH twist and rise when C21 is triggered
            actual_delta = r_delta / 2.0 if is_c21 else r_delta
            max_rise_cap = 2.5 if is_c21 else 5.0
            
            if entry_rise.text():
                val = float(entry_rise.text())
                # SPLIT: Set min and max separately
                entry_rise_min.setText(fmt(val - actual_delta))
                entry_rise_max.setText(fmt(min(val + actual_delta, max_rise_cap)))
            else:
                entry_rise_min.clear()
                entry_rise_max.clear()
            
            if entry_twist.text():
                val = float(entry_twist.text())
                # SPLIT: Set min and max separately
                entry_twist_min.setText(fmt(val - actual_delta))
                entry_twist_max.setText(fmt(val + actual_delta))
            else:
                entry_twist_min.clear()
                entry_twist_max.clear()
                
        except ValueError:
            pass

    # Connect dropdown to this new function immediately
    combo_range.currentTextChanged.connect(update_ranges)

    def on_left_handed_clicked(checked):
        twist_str = entry_twist.text().strip()
        if not twist_str:
            return
        try:
            twist_val = float(twist_str)
            # 1st and 4th Quadrant (-90 to 90)
            if -90 <= twist_val <= 90:
                new_twist = -abs(twist_val) if checked else abs(twist_val)
                entry_twist.setText(fmt(new_twist))
                update_ranges()
            # 2nd and 3rd Quadrant (90 to 270)
            elif 90 < twist_val <= 270:
                new_twist = 360.0 - twist_val
                entry_twist.setText(fmt(new_twist))
                update_ranges()
        except ValueError:
            pass

    check_left.clicked.connect(on_left_handed_clicked)

    def calculate():
        try:
            left_handed = check_left.isChecked()
            c21 = check_c21.isChecked()
            rise_str = entry_rise.text().strip()
            crossover_str = entry_crossover.text().strip()
            twist_str = entry_twist.text().strip()

            empty_count = sum(1 for s in [rise_str, crossover_str, twist_str] if not s)
            if empty_count != 1:
                result_label.setText("Error: Exactly one input must be empty.")
                result_label.setStyleSheet("color: red;")
                return

            rise = float(rise_str) if rise_str else None
            crossover = float(crossover_str) if crossover_str else None
            twist = float(twist_str) if twist_str else None

            result_label.setText("") 
            
            if twist is None:
                if rise is None or crossover is None or crossover == 0:
                    result_label.setText("Error: Rise and Crossover needed.")
                    return
                twist_val = (180 * rise) / crossover
                if left_handed:
                    twist_val = -twist_val 
                if c21 and left_handed:
                    new_twist = 180 + (twist_val / 2)
                    new_rise = rise / 2
                    entry_rise.setText(fmt(new_rise))
                    twist_val = new_twist
                entry_twist.setText(fmt(twist_val))
                if c21 and not left_handed:
                    new_twist = 180 + (twist_val / 2)
                    new_rise = rise / 2
                    entry_rise.setText(fmt(new_rise))
                    twist_val = new_twist
                entry_twist.setText(fmt(twist_val))

            elif crossover is None:
                if rise is None or twist is None or rise == 0:
                    result_label.setText("Error: Rise and Twist needed.")
                    return
                if c21:
                    crossover_val = abs((180 * rise) / (twist - 180))
                else:
                    crossover_val = (180 * rise) / abs(twist)
                
                if not c21:
                    if left_handed and twist < 0:
                        pass
                    elif not left_handed and twist < 0:
                        crossover_val = -crossover_val

                entry_crossover.setText(fmt(crossover_val))

            elif rise is None:
                if crossover is None or twist is None or crossover == 0:
                    result_label.setText("Error: Crossover and Twist needed.")
                    return
                
                if c21:
                    # New formula for C21: Rise = |(Twist - 180) * Crossover| / 180
                    rise_val = abs((twist - 180) * crossover) / 180
                else:
                    rise_val = (abs(twist) * crossover) / 180
                
                entry_rise.setText(fmt(rise_val))
            
            update_ranges()

        except ValueError:
            result_label.setText("Error: Invalid number format.")
            result_label.setStyleSheet("color: red;")
        except Exception as e:
            result_label.setText(f"Error: {str(e)}")
            result_label.setStyleSheet("color: red;")

    btn_layout = QHBoxLayout()
    
    btn_calc = QPushButton("Calculate")
    btn_calc.clicked.connect(calculate)
    btn_layout.addWidget(btn_calc)
    
    btn_convert = QPushButton("Convert C1 <-> C21")
    def convert_c1_c21():
        try:
            rise_str = entry_rise.text().strip()
            crossover_str = entry_crossover.text().strip()
            twist_str = entry_twist.text().strip()
            
            empty_count = sum(1 for s in [rise_str, crossover_str, twist_str] if not s)
            
            # Only trigger calculation if exactly one field is missing
            if empty_count == 1:
                calculate()
                if "Error" in result_label.text():
                    return
            elif empty_count > 1:
                result_label.setText("Error: At least two inputs must be filled to convert.")
                result_label.setStyleSheet("color: red;")
                return
            else:
                # If all three are filled, clear any previous error messages
                result_label.setText("")
            
            # Fetch the latest variables (updated if calculate() was called)
            rise_str = entry_rise.text().strip()
            twist_str = entry_twist.text().strip()
            
            if not rise_str or not twist_str:
                result_label.setText("Error: Rise and Twist must be valid to convert.")
                result_label.setStyleSheet("color: red;")
                return
                
            r = float(rise_str)
            t = float(twist_str)
            is_c21 = check_c21.isChecked()
            
            if not is_c21:
                # Convert C1 to C21
                new_r = r / 2.0
                new_t = 180.0 + (t / 2.0)
                check_c21.setChecked(True)
            else:
                # Convert C21 to C1
                new_r = r * 2.0
                new_t = (t - 180.0) * 2.0
                check_c21.setChecked(False)
                
            entry_rise.setText(fmt(new_r))
            entry_twist.setText(fmt(new_t))
            update_ranges()
            
        except ValueError:
            result_label.setText("Error: Invalid number format for Rise or Twist.")
            result_label.setStyleSheet("color: red;")

    btn_convert.clicked.connect(convert_c1_c21)
    btn_layout.addWidget(btn_convert)
    
    layout.addLayout(btn_layout)
    
    twist_window.show()

