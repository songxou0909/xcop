    def read_mrc_simple(filename):
        with open(filename, 'rb') as f:
            header = np.fromfile(f, dtype=np.int32, count=256)
            nx, ny, nz = header[0], header[1], header[2]
            mode = header[3]
            
            if mode == 0: dtype = np.uint8
            elif mode == 1: dtype = np.int16
            elif mode == 2: dtype = np.float32
            elif mode == 4: dtype = np.complex64
            else: return None 
            
            f.seek(1024)
            ext_bytes = header[23]
            if ext_bytes > 0:
                f.seek(f.tell() + ext_bytes)

            count = nx * ny * nz
            data = np.fromfile(f, dtype=dtype, count=count)
            
            if data.size != count: return None
            
            data = data.reshape((nx, ny, nz), order='F')
            if dtype != np.float32: data = data.astype(np.float32)
            return data

    def simple_gaussian_smooth(image, sigma=1.5):
        radius = int(3 * sigma)
        x = np.arange(-radius, radius + 1)
        kernel = np.exp(-x**2 / (2 * sigma**2))
        kernel = kernel / np.sum(kernel)
        temp_img = np.apply_along_axis(lambda m: np.convolve(m, kernel, mode='same'), axis=0, arr=image)
        smoothed_img = np.apply_along_axis(lambda m: np.convolve(m, kernel, mode='same'), axis=1, arr=temp_img)
        return smoothed_img

    class MrcPreviewCanvas(FigureCanvas):
        def __init__(self, parent=None, width=5, height=5, dpi=100):
            self.fig = Figure(figsize=(width, height), dpi=dpi)
            self.fig.patch.set_facecolor('#2c2c2c') 
            self.axes = self.fig.add_subplot(111)
            self.axes.set_facecolor('#2c2c2c')
            self.axes.axis('off')
            
            super(MrcPreviewCanvas, self).__init__(self.fig)
            self.setParent(parent)
            self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
            self.updateGeometry()

        def update_plot(self, files):
            self.axes.clear()
            self.axes.axis('off')
            
            if not files:
                self.axes.text(0.5, 0.5, "No Files Selected", ha='center', va='center', color='white')
                self.draw()
                return

            colors = ['white', 'cornflowerblue', 'cyan', 'magenta', 'yellow', 'lime', 'orange']
            THICKNESS = 10 
            
            all_min_x, all_max_x = [], []
            all_min_y, all_max_y = [], []
            has_data = False

            for i, filename in enumerate(files):
                try:
                    vol = read_mrc_simple(filename)
                    if vol is None: continue

                    nz = vol.shape[2]
                    mid_z = nz // 2
                    z_start = max(0, mid_z - THICKNESS // 2)
                    z_end = min(nz, mid_z + THICKNESS // 2)
                    
                    slab_data = np.mean(vol[:, :, z_start:z_end], axis=2).T
                    slice_to_plot = simple_gaussian_smooth(slab_data, sigma=1.5)
                    
                    mean = np.mean(slice_to_plot)
                    std = np.std(slice_to_plot)
                    start_level = mean + 3.0 * std
                    max_level = np.max(slice_to_plot)
                    if start_level >= max_level: start_level = mean + 1.0 * std
                    
                    levels = np.linspace(start_level, max_level, 10)
                    color = colors[i % len(colors)]
                    
                    self.axes.contour(
                        slice_to_plot, levels=levels, colors=[color],
                        linewidths=1.0, origin='lower', alpha=0.9
                    )
                    
                    self.axes.plot([], [], color=color, label=os.path.basename(filename))

                    mask = slice_to_plot > start_level
                    if np.any(mask):
                        rows, cols = np.where(mask)
                        all_min_y.append(np.min(rows))
                        all_max_y.append(np.max(rows))
                        all_min_x.append(np.min(cols))
                        all_max_x.append(np.max(cols))
                        has_data = True

                except Exception as e:
                    print(f"Preview error for {filename}: {e}")

            if has_data:
                padding = 50 # Increased padding slightly
                min_x, max_x = min(all_min_x), max(all_max_x)
                min_y, max_y = min(all_min_y), max(all_max_y)
                self.axes.set_xlim(min_x - padding, max_x + padding)
                self.axes.set_ylim(min_y - padding, max_y + padding)
            else:
                self.axes.set_aspect('equal')

            self.axes.legend(loc='upper right', frameon=False, fontsize=8, labelcolor='white')
            self.draw()

