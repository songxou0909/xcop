# Function to execute command in cluster
def execute_command(command, run_button):
    if not command:
        show_error_message("No command entered.")
        run_button.setEnabled(True)
        return

    write_to_log(command)
    run_button.setEnabled(False)

    if 'app' in globals() and app:
        app.output_text.setText(f"Command Sent\n\n{app.output_text.toPlainText()}")
    
    try:
        subprocess.Popen(command, shell=True, executable="/bin/bash")
    except Exception as e:
        show_error_message(f"Error executing command: {str(e)}")
    finally:
        run_button.setEnabled(True)

# Function to create set of expected .eer filenames from jpg_directory OR a text filelist
def create_filelist_document(input_path, movies_folder="Movies"):
    try:
        jpg_files = []
        
        # Check if input is a text file containing the list
        if os.path.isfile(input_path):
            with open(input_path, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if line:
                        # Extract just the filename in case the list contains full paths
                        basename = os.path.basename(line)
                        # Remove the .jpg extension if present
                        name, ext = os.path.splitext(basename)
                        if ext.lower() == '.jpg':
                            basename = name
                        jpg_files.append(basename)
        # Otherwise, treat it as a directory (original behavior)
        elif os.path.isdir(input_path):
            jpg_files = [f for f in os.listdir(input_path) if f.endswith('.jpg')]
        else:
            return None

        # Create set of expected .eer filenames
        eer_filenames = set()
        for filename in jpg_files:
            # Handle cases where the list already has .eer extensions, or convert .jpg to _EER.eer
            if filename.endswith('.jpg'):
                modified_name = filename.replace('.jpg', '_EER.eer')
            elif filename.endswith('.eer'):
                modified_name = filename
            else:
                # Fallback if the list just has base names without extensions
                modified_name = f"{filename}_EER.eer"
            
            eer_filenames.add(modified_name)
            
        return eer_filenames
    except Exception as e:
        print(f"Error processing file/folder: {e}")
        return None

# Function to move unmatched .eer files to Movies_bad and return file counts
def move_and_rename_files(eer_filenames, movies_folder="Movies"):
    try:
        # Create bad_movies at the same level as the movies folder
        parent_dir = os.path.dirname(os.path.abspath(movies_folder))
        bad_folder = os.path.join(parent_dir, "bAD_mOviEs")
        if not os.path.exists(bad_folder):
            os.makedirs(bad_folder)
        
        # Get list of .eer files in Movies and count them
        eer_files = [f for f in os.listdir(movies_folder) if f.endswith('_EER.eer')]
        initial_count = len(eer_files)
        
        # Move unmatched .eer files to Movies_bad and count them
        moved_count = 0
        for filename in eer_files:
            if filename not in eer_filenames:
                shutil.move(os.path.join(movies_folder, filename), os.path.join(bad_folder, filename))
                moved_count += 1
        
        # Count remaining .eer files in Movies
        remaining_eer_files = [f for f in os.listdir(movies_folder) if f.endswith('_EER.eer')]
        remaining_count = len(remaining_eer_files)
        
        return True, initial_count, moved_count, remaining_count
    except Exception as e:
        return False, 0, 0, 0

