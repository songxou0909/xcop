def get_json_path():
    JSON_DIR = os.path.join(base_path, "xcop_savings")
    os.makedirs(JSON_DIR, exist_ok=True)
    safe_name = user_name or "general"
    # Sanitize filename
    safe_name = re.sub(r'[^\w\-]', '_', safe_name)
    return os.path.join(JSON_DIR, f"last_inputs_{safe_name}.json")

def _make_user_json(user: str) -> str:
    """Write a temporary JSON with {"user": "<user>"} and return its path."""
    import tempfile
    tmp = tempfile.NamedTemporaryFile(
        mode="w", suffix=".json", prefix="xcop_user_", delete=False, encoding="utf-8"
    )
    payload = {"user": user}  # <-- ALWAYS include the key
    json.dump(payload, tmp)
    tmp.close()
    return tmp.name

# Helper class to handle resize events for saving window sizes (replaces .bind("<Configure>"))
class ResizeEventFilter(QObject):
    def __init__(self, window_type, window_ref):
        super().__init__()
        self.window_type = window_type
        self.window_ref = window_ref

    def eventFilter(self, obj, event):
        if event.type() == QEvent.Type.Resize:
            if user_name:
                global window_sizes
                window_sizes.setdefault(user_name, {})[self.window_type] = (obj.width(), obj.height())
                # To avoid excessive disk writes, we might want to debounce this in a full app,
                # but following original logic:
                save_last_inputs()
        return False

# Function to load last inputs, window sizes, and theme from JSON file
def load_last_inputs():
    global last_inputs, last_rescale_inputs, last_symmetry_inputs, last_topaz_inputs, last_invert_inputs, last_xmipp_inputs
    global last_molmap_inputs, last_molmap_blue_inputs, last_molmap_final_red_inputs, last_molmap_final_blue_inputs, last_omni_whiteboard
    global last_separate_movies_inputs, last_movie_frames, window_sizes

    JSON_PATH = get_json_path()
    data = {}
    current_user = user_name or "general"

    # --- READ JSON WITH SHARED LOCK ---
    if os.path.exists(JSON_PATH):
        try:
            with open(JSON_PATH, "r") as f:
                fcntl.flock(f.fileno(), fcntl.LOCK_SH)
                try:
                    data = json.load(f)
                except json.JSONDecodeError as e:
                    print(f"JSON decode error in {JSON_PATH}: {e}")
                    data = {}
                finally:
                    fcntl.flock(f.fileno(), fcntl.LOCK_UN)
        except Exception as e:
            print(f"Error reading {JSON_PATH}: {e}")
            data = {}

    # --- Load user data ---
    user_data = data.get(current_user, {})

    last_inputs = user_data.get("building", None)
    last_rescale_inputs = user_data.get("rescale", None)
    last_symmetry_inputs = user_data.get("symmetry", None)
    last_topaz_inputs = user_data.get("topaz", None)
    last_invert_inputs = user_data.get("invert", None)
    last_molmap_inputs = user_data.get("molmap", None)
    last_molmap_blue_inputs = user_data.get("molmap_blue", None)
    last_molmap_final_red_inputs = user_data.get("molmap_final_red", None)
    last_molmap_final_blue_inputs = user_data.get("molmap_final_blue", None)
    last_omni_whiteboard = user_data.get("omni_whiteboard", None)
    last_separate_movies_inputs = user_data.get("separate_movies", None)
    last_movie_frames = user_data.get("movie_frames", None)
    last_xmipp_inputs = user_data.get("xmipp", None)
    window_sizes[current_user] = user_data.get("window_sizes", {})

    # --- PRESERVE YOUR MODEL VALIDATION LOGIC ---
    if last_inputs and len(last_inputs) > 4:
        saved_model = last_inputs[2]
        saved_folder = last_inputs[4] or "iniModel"
        if saved_model and saved_model != "Custom":
            model_path = os.path.join(saved_folder, saved_model)
            if not os.path.isdir(model_path):
                print(f"Invalid model path: {model_path} → clearing saved model")

                last_inputs[2] = ""  # Clear invalid model
                data.setdefault(current_user, {})["building"] = last_inputs

                # --- SAFELY WRITE CORRECTION WITH EXCLUSIVE LOCK ---
                try:
                    with open(JSON_PATH, "w") as f:
                        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
                        json.dump(data, f, indent=2)
                        f.flush()
                        os.fsync(f.fileno())
                        fcntl.flock(f.fileno(), fcntl.LOCK_UN)
                except Exception as e:
                    print(f"Failed to save corrected JSON {JSON_PATH}: {e}")

    return data

# Function to save last inputs, window sizes, and theme to JSON file
def save_last_inputs():
    global user_name, window_sizes, last_movie_frames

    JSON_PATH = get_json_path()
    current_user = user_name or "general"

    try:
        os.makedirs(os.path.dirname(JSON_PATH), exist_ok=True)

        # --- READ CURRENT DATA (if exists) WITH SHARED LOCK ---
        data = {}
        if os.path.exists(JSON_PATH):
            try:
                with open(JSON_PATH, "r") as f:
                    fcntl.flock(f.fileno(), fcntl.LOCK_SH)
                    try:
                        data = json.load(f)
                    except json.JSONDecodeError:
                        print(f"Corrupted JSON in {JSON_PATH}, starting fresh.")
                        data = {}
                    finally:
                        fcntl.flock(f.fileno(), fcntl.LOCK_UN)
            except Exception as e:
                print(f"Error reading {JSON_PATH} for save: {e}")
                data = {}

        data[current_user] = {
            "building": last_inputs,
            "rescale": last_rescale_inputs,
            "symmetry": last_symmetry_inputs,
            "topaz": last_topaz_inputs,
            "invert": last_invert_inputs,
            "molmap": last_molmap_inputs,
            "molmap_blue": last_molmap_blue_inputs,
            "molmap_final_red": last_molmap_final_red_inputs,
            "molmap_final_blue": last_molmap_final_blue_inputs,
            "omni_whiteboard": last_omni_whiteboard,
            "separate_movies": last_separate_movies_inputs,
            "movie_frames": last_movie_frames,
            "xmipp": last_xmipp_inputs,
            "window_sizes": window_sizes.get(current_user, {}),
        }

        # --- WRITE WITH EXCLUSIVE LOCK ---
        with open(JSON_PATH, "w") as f:
            fcntl.flock(f.fileno(), fcntl.LOCK_EX)
            try:
                json.dump(data, f, indent=2)
                f.flush()
                os.fsync(f.fileno())  # Force to disk
            finally:
                fcntl.flock(f.fileno(), fcntl.LOCK_UN)

    except Exception as e:
        print(f"Error saving {JSON_PATH}: {e}")

