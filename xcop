# --- SETTINGS FUNCTIONS ---
def open_settings_window():
    # Show loading status
    if 'app' in globals() and app:
        app.output_text.setText("Fetching available software modules... Please wait.")
        QApplication.processEvents()

    # Run module avail
    try:
        cmd = "bash -l -c 'module avail 2>&1'"
        process = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, text=True)
        output, _ = process.communicate()
    except Exception as e:
        output = ""
        print(f"Error fetching modules: {e}")

    software_modules = {
        'relion': [],
        'xmipp': [],
        'servalcat': [],
        'phenix': [],
        'chimera': []
    }
    
    for line in output.split('\n'):
        for word in line.split():
            clean_word = word.replace('(default)', '').replace('(D)', '').strip()
            word_lower = clean_word.lower()
            for sw in software_modules.keys():
                if sw in word_lower and clean_word not in software_modules[sw]:
                    software_modules[sw].append(clean_word)
    
    # Ensure fallback if missing
    for sw in software_modules:
        if not software_modules[sw]:
            software_modules[sw].append(f"Not Found: Ask IT support to install {sw}")

    # Build the Settings Window
    win = QWidget()
    win.setWindowTitle("xcop Settings")
    center_window(win, 550, 300, "settings_window")
    toplevel_windows.append(win)
    if 'app' in globals() and app: 
        win.setStyleSheet(app.styleSheet())
    
    layout = QVBoxLayout(win)
    
    title_label = QLabel("Select versions for your environment:")
    title_label.setStyleSheet("font-weight: bold; font-size: 11pt;")
    layout.addWidget(title_label)
    
    grid = QGridLayout()
    layout.addLayout(grid)
    
    combos = {}
    row = 0
    
    # Current active variables mapped to dropdowns
    current_versions = {
        'relion': RELION_VER,
        'xmipp': XMIPP_VER,
        'servalcat': SERVALCAT_VER,
        'phenix': PHENIX_VER,
        'chimera': CHIMERA_VER
    }

