    text_box = QTextEdit()
    main_layout.addWidget(text_box)
    
    if last_omni_whiteboard:
        text_box.setText(last_omni_whiteboard)

    # Search Logic
    def highlight_matches():
        global search_matches, current_match_index
        search_term = search_entry.text()
        search_matches = []
        current_match_index = -1
        
        # Clear existing selections
        text_box.setExtraSelections([])
        
        if not search_term:
            match_count_label.setText("No matches found")
            current_match_label.setText("Current: 0/0")
            return

        doc = text_box.document()
        # Standard highlight format
        highlight_format = QTextCharFormat()
        bg_col = "#927027" if getattr(app, 'is_dark_mode', True) else "yellow"
        fg_col = "white" if getattr(app, 'is_dark_mode', True) else "black"
        highlight_format.setBackground(QColor(bg_col))
        highlight_format.setForeground(QColor(fg_col))

        cursor = QTextCursor(doc)
        while not cursor.isNull() and not cursor.atEnd():
            cursor = doc.find(search_term, cursor)
            if not cursor.isNull():
                # Store the position (int), not the cursor object, to be safer
                search_matches.append((cursor.selectionStart(), cursor.selectionEnd()))

        if not search_matches:
            match_count_label.setText("No matches found")
            current_match_label.setText("Current: 0/0")
            QMessageBox.information(input_window, "Search", f"No matches found for '{search_term}'.")
        else:
            match_count_label.setText(f"Found {len(search_matches)} match(es)")
            current_match_index = 0
            render_highlights()

    def render_highlights():
        if not search_matches: return
        
        extra_selections = []
        
        # Formats
        std_bg = "#927027" if getattr(app, 'is_dark_mode', True) else "yellow"
        cur_bg = "#15771A" if getattr(app, 'is_dark_mode', True) else "#90EE90"
        fg_col = "white" if getattr(app, 'is_dark_mode', True) else "black"

        std_fmt = QTextCharFormat()
        std_fmt.setBackground(QColor(std_bg))
        std_fmt.setForeground(QColor(fg_col))
        
        cur_fmt = QTextCharFormat()
        cur_fmt.setBackground(QColor(cur_bg))
        cur_fmt.setForeground(QColor(fg_col))

        doc = text_box.document()

        for i, (start, end) in enumerate(search_matches):
            cursor = QTextCursor(doc)
            cursor.setPosition(start)
            cursor.setPosition(end, QTextCursor.MoveMode.KeepAnchor)
            
            sel = QTextEdit.ExtraSelection()
            sel.cursor = cursor
            if i == current_match_index:
                sel.format = cur_fmt
                # Scroll to view
                text_box.setTextCursor(cursor)
                text_box.ensureCursorVisible()
            else:
                sel.format = std_fmt
            extra_selections.append(sel)
            
        text_box.setExtraSelections(extra_selections)
        current_match_label.setText(f"Current: {current_match_index + 1}/{len(search_matches)}")

    def find_next():
        global current_match_index
        if not search_matches: return
        current_match_index = (current_match_index + 1) % len(search_matches)
        render_highlights()

    def find_previous():
        global current_match_index
        if not search_matches: return
        current_match_index = (current_match_index - 1) % len(search_matches)
        render_highlights()

    def clear_highlights():
        global search_matches, current_match_index
        search_matches = []
        current_match_index = -1
        text_box.setExtraSelections([])
        match_count_label.setText("No matches found")
        current_match_label.setText("Current: 0/0")

    def jump_to_match():
        global current_match_index
        if not search_matches: return
        try:
            val = int(jump_entry.text()) - 1
            if 0 <= val < len(search_matches):
                current_match_index = val
                render_highlights()
            else:
                show_error_message(f"Please enter a number between 1 and {len(search_matches)}.")
        except ValueError:
            pass

    # Connect buttons
    search_button.clicked.connect(highlight_matches)
    find_next_button.clicked.connect(find_next)
    find_prev_button.clicked.connect(find_previous)
    clear_button.clicked.connect(clear_highlights)
    jump_button.clicked.connect(jump_to_match)

    # Save Buttons
    save_frame = QHBoxLayout()
    
    def save_inputs():
        global last_omni_whiteboard
        last_omni_whiteboard = text_box.toPlainText().rstrip()
        save_last_inputs()

    def save_and_exit():
        save_inputs()
        close_toplevel_windows()

    save_btn = QPushButton("Save")
    save_btn.clicked.connect(save_inputs)
    save_frame.addWidget(save_btn)
    
    save_exit_btn = QPushButton("Save and Exit")
    save_exit_btn.clicked.connect(save_and_exit)
    save_frame.addWidget(save_exit_btn)
    
    main_layout.addLayout(save_frame)
    input_window.show()

