        # 2. Prepare commands list (Create the WHOLE list first)
        cmds = []
        for input_path in selected_files:
            dirname, basename = os.path.split(input_path)
            output_path = os.path.join(dirname, f"symEx_{basename}")

            print(f"Parameters used: \nPixel size: {params['pix'].text()}, Twist: {params['twist'].text()}, Rise: {params['rise'].text()}, Tube Diameter: {params['diam'].text()}, Z value: {float(params['z_perc'].text()) / 100:.2f}")
            
            cmd = (
                f"module load {RELION_VER} && relion_helix_toolbox --impose --i {input_path} --o {output_path} "
                f"--angpix {params['pix'].text()} "
                f"--twist {params['twist'].text()} "
                f"--rise {params['rise'].text()} "
                f"--cyl_outer_diameter {params['diam'].text()} "
                f"--z_percentage {float(params['z_perc'].text()) / 100:.2f}"
            )
            cmds.append(cmd)

        # 3. Instantiate Signals
        # Note: We must keep a reference to 'signals' so it doesn't get garbage collected
        # attaching it to 'win' is a safe way to keep it alive during the thread.
        win.signals = WorkerSignals()

        # 4. Define Worker and Slots (Must be defined BEFORE starting thread)
        def worker(cmd_list):
            try:
                for cmd in cmd_list:
                    write_to_log(cmd)
                    subprocess.call(cmd, shell=True, executable="/bin/bash")
                win.signals.finished.emit()
            except Exception as e:
                win.signals.error.emit(str(e))

        def on_finished():
