    def live_help_trigger(self):
        # We need to block signals momentarily to avoid infinite recursion if we modify text
        content = self.output_text.toPlainText().strip()
        if content == "??":
            self.output_text.blockSignals(True)
            self.output_text.clear()
            self.output_text.blockSignals(False)
            self.open_help_window()
            # Restore focus to output text
            self.output_text.setFocus()
        elif content.lower() == "log":
            self.output_text.blockSignals(True)
            self.output_text.clear()
            self.output_text.blockSignals(False)
            open_log_viewer()
            self.output_text.setFocus()
        elif content.lower() in ["setting", "settings"]:
