    def update_default_input_path():
        job_num = job_number_entry.text().strip()
        if job_num.isdigit():
            j_str = job_num.zfill(3)
            # Define potential paths
            guessed_pp = f"PostProcess/job{j_str}/postprocess.mrc"
            guessed_ref = f"Refine3D/job{j_str}/run_half1_class001_unfil.mrc"

            # Check current text to allow overwrite if empty or if it looks like an auto-path
            current = input_path_entry.text()
            if not current or "PostProcess/job" in current or "Refine3D/job" in current:
                 if os.path.isfile(guessed_pp):
                     input_path_entry.setText(guessed_pp)
                 elif os.path.isfile(guessed_ref):
                     input_path_entry.setText(guessed_ref)

            # Auto-fill Twist and Rise (Triggers once per unique job number)
            if getattr(input_window, '_last_autofilled_job', None) != j_str:
                run_out_path = None
                
                # 1. Check note.txt if it's a PostProcess job
                note_path = f"PostProcess/job{j_str}/note.txt"
                if os.path.isfile(note_path):
                    try:
                        with open(note_path, 'r', encoding='utf-8') as f:
                            # Added Class3D support just in case
                            match = re.search(r'(Refine3D|Class3D)/job(\d+)', f.read())
                            if match:
                                run_out_path = f"{match.group(1)}/job{match.group(2)}/run.out"
                    except Exception:
                        pass
                
                # 2. Fallback: assume Job Number is directly a Refine3D or Class3D job
                if not run_out_path:
                    if os.path.isfile(f"Refine3D/job{j_str}/run.out"):
                        run_out_path = f"Refine3D/job{j_str}/run.out"
                    elif os.path.isfile(f"Class3D/job{j_str}/run.out"):
                        run_out_path = f"Class3D/job{j_str}/run.out"
                
                # 3. Parse run.out for the VERY LAST occurrence of averaged twist and rise
                if run_out_path and os.path.isfile(run_out_path):
                    try:
                        with open(run_out_path, 'r', encoding='utf-8') as f:
                            content = f.read().lower()
                            # re.findall grabs every single iteration. We will explicitly select the last one.
                            matches = re.findall(r'averaged helical twist = ([-+]?\d*\.?\d+) degrees, rise = ([-+]?\d*\.?\d+)', content)
                            
                            if matches:
                                last_twist, last_rise = matches[-1] # [-1] forces the absolute latest iteration
                                entries[2].setText(last_twist)
                                entries[3].setText(last_rise)
                                # Lock it to the current job so manual edits aren't aggressively overwritten
                                input_window._last_autofilled_job = j_str
                    except Exception:
