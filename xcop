def create_splash_pixmap():
    """Generates the high-fidelity protein network splash image entirely in memory."""
    width, height = 400, 400
    pixmap = QPixmap(width, height)
    pixmap.fill(QColor("#151515")) 

    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setRenderHint(QPainter.RenderHint.TextAntialiasing)

    gradient = QRadialGradient(width / 2, height / 2, width / 1.5)
    gradient.setColorAt(0.0, QColor("#2a2a2e"))
    gradient.setColorAt(1.0, QColor("#0f0f11"))
    painter.fillRect(0, 0, width, height, gradient)

    random.seed(42) 

    # Appreciate the Orb2 3Ha Structure
    lines_data = [[(-28, 272), (-11, 271), (0, 258), (16, 258), (27, 244), (44, 243), (54, 229), (71, 226), (82, 212), (99, 210), (104, 194), (121, 188), (128, 173), (143, 163), (154, 176), (170, 183), (180, 196), (168, 209), (177, 222), (169, 238), (153, 231), (139, 241), (123, 236), (113, 250), (95, 250), (85, 264), (68, 267), (58, 280), (40, 282), (31, 297), (15, 303)], 
                  [(128, -27), (138, -14), (155, -11), (164, 3), (181, 7), (189, 22), (206, 24), (216, 39), (233, 42), (244, 56), (261, 53), (273, 65), (290, 63), (306, 71), (299, 87), (302, 103), (295, 119), (278, 114), (271, 129), (254, 129), (251, 114), (235, 107), (232, 90), (215, 85), (206, 70), (189, 68), (180, 53), (163, 51), (152, 37), (135, 34), (125, 19)], 
                  [(417, 149), (400, 150), (390, 164), (373, 164), (362, 178), (345, 179), (335, 193), (318, 197), (308, 211), (291, 213), (286, 230), (269, 236), (263, 252), (248, 261), (237, 249), (221, 243), (211, 229), (222, 216), (215, 204), (223, 188), (236, 193), (250, 183), (267, 189), (278, 175), (295, 174), (304, 159), (321, 157), (332, 143), (349, 141), (358, 125), (374, 119)]]

    beta_placements = [(-11, 271), (0, 258), (16, 258), (27, 244), (71, 226), (82, 212), (99, 210), (104, 194), (121, 188), (128, 173), (139, 241), (123, 236), (113, 250), (95, 250), (85, 264), (68, 267), (58, 280), (40, 282), 
                       (138, -14), (155, -11), (164, 3), (181, 7), (216, 39), (233, 42), (244, 56), (261, 53), (273, 65), (290, 63), (235, 107), (232, 90), (215, 85), (206, 70), (189, 68), (180, 53), (163, 51), (152, 37), 
                       (400, 150), (390, 164), (373, 164), (362, 178), (318, 197), (308, 211), (291, 213), (286, 230), (269, 236), (263, 252), (250, 183), (267, 189), (278, 175), (295, 174), (304, 159), (321, 157), (332, 143), (349, 141)]
    # --- Spiral Mathematics ---
    def transform(x, y, scale, angle, cx=200, cy=200):
        """Translates, rotates, and scales a point around a center point (cx, cy)."""
        tx, ty = x - cx, y - cy
        rx = tx * math.cos(angle) - ty * math.sin(angle)
        ry = tx * math.sin(angle) + ty * math.cos(angle)
        return rx * scale + cx, ry * scale + cy

    # Parameters to control the depth and shape of the spiral
    num_layers = 42
    angle_step = -0.025056  # Radians to rotate per layer (-1.43562 degree per layer - Real Orb2 3Ha Structure Twist)
    scale_step = 0.982  # Shrink ratio per layer (1.8% reduction per step)
    
    # Pre-collect nodes since we need to draw background dots first
    unique_nodes = set()
    for line in lines_data:
        unique_nodes.update(line)

    # 1. Draw Background Spiral Layers (Deepest to Shallowest)
    for layer in range(num_layers, 0, -1):
        # Calculate current scale and rotation based on layer depth
        scale = scale_step ** layer
        angle = angle_step * layer
        
        # Exponential fading: increasing the power makes it fade out much faster
        fade_speed = 3.2  # Increase this number to make it fade faster
        alpha = int(200 * max(0, (1 - (layer / (num_layers + 1))) ** fade_speed))
        grey_color = QColor(150, 150, 150, alpha)
        
        # Draw background lines
        painter.setPen(QPen(grey_color, 1.0))
        for line in lines_data:
            for i in range(len(line) - 1):
                x1, y1 = transform(line[i][0], line[i][1], scale, angle)
                x2, y2 = transform(line[i+1][0], line[i+1][1], scale, angle)
                painter.drawLine(int(x1), int(y1), int(x2), int(y2))
                
        # Draw background dots (Strictly grey, scaling down sizes dynamically for depth)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QBrush(grey_color))
        for x, y in unique_nodes:
            tx, ty = transform(x, y, scale, angle)
            dot_size = max(2, int(8 * scale)) 
            offset = dot_size / 2.0
            painter.drawEllipse(int(tx - offset), int(ty - offset), dot_size, dot_size)

    # 2. Draw the Original Layer (Layer 0, placed directly on top)
    # The second value (3.5) is the line thickness. Increase it for thicker lines.
    painter.setPen(QPen(QColor(152, 195, 121, 180), 3.5)) 
    for line in lines_data:
        for i in range(len(line) - 1):
            x1, y1 = line[i]
            x2, y2 = line[i+1]
            painter.drawLine(x1, y1, x2, y2)
                    
    for x, y in unique_nodes:
        if (x, y) in beta_placements:
            color = QColor("#ffffff")
        else:
            color = QColor("#98c379")
            
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QBrush(color))
        painter.drawEllipse(int(x) - 4, int(y) - 4, 8, 8)

    font = QFont("Arial", 54, QFont.Weight.Bold)
    font.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 2)
    painter.setFont(font)
    fm = painter.fontMetrics()
    
    text_x = "x"
    text_cop = "cop"
    
    width_x = fm.horizontalAdvance(text_x)
    width_cop = fm.horizontalAdvance(text_cop)
    total_width = width_x + width_cop
    
    start_x = (width - total_width) // 2
    text_y = height - 70 
    
    painter.setPen(QColor("#98c379"))
    painter.drawText(start_x, text_y, text_x)
    
    painter.setPen(QColor("#ffffff"))
    painter.drawText(start_x + width_x, text_y, text_cop)

    painter.setPen(QPen(QColor("#3e3e42"), 2))
    painter.setBrush(Qt.BrushStyle.NoBrush)
    painter.drawRect(0, 0, width, height)

    painter.end()
    return pixmap

