        sections = {}
        
        if not os.path.exists(help_path):
            content_text.setText(f"Help file not found:\n{help_path}")
        else:
            current_section = None
            section_lines = []
            
            try:
                with open(help_path, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.rstrip()
                        if line.startswith("## ") and line.endswith(" ##"):
                            if current_section:
                                sections[current_section] = "\n".join(section_lines)
                            current_section = line[3:-3].strip()
                            section_lines = []
                        elif current_section:
                            section_lines.append(line)
                    if current_section:
                        sections[current_section] = "\n".join(section_lines)
            except Exception as e:
                content_text.setText(f"Error reading help file: {e}")

            # Populate TOC
            for title in sections.keys():
                toc_list.addItem(title)
                
            # Click Handler
            def on_toc_click(item):
                title = item.text()
                content = sections.get(title, "No content.")
                content_text.setText(content)
                
            toc_list.itemClicked.connect(on_toc_click)
            
            # Select first item if exists
            if toc_list.count() > 0:
                toc_list.setCurrentRow(0)
                on_toc_click(toc_list.item(0))

        self.help_window.show()

    def closeEvent(self, event):
        global active_subprocesses
        for p in active_subprocesses:
            if p.poll() is None:
                try:
                    p.terminate()
                except Exception as e:
                    print(f"Error closing background process: {e}")
        
        # Ensure all floating subwindows are destroyed when main window closes
        close_toplevel_windows()
        
        event.accept()

