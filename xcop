    def check_pdb_state():
        pdb_path = entry_pdb.text().strip()
        if not pdb_path or not os.path.exists(pdb_path):
            btn_run.setEnabled(False)
            btn_run_chimerax.setEnabled(False)
            return

        import numpy as np
        import math
        
        chains = {}
        try:
            with open(pdb_path, 'r') as f:
                for line in f:
                    if line.startswith("ATOM") and line[12:16].strip() == "CA":
                        chain_id = line[20:22].strip()
                        res_id = line[22:27].strip()
                        try:
                            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])
                            if chain_id not in chains: chains[chain_id] = []
                            chains[chain_id].append({'id': res_id, 'coord': np.array([x,y,z])})
                        except: pass
        except Exception:
            pass
            
        if not chains:
            btn_run.setEnabled(False)
            btn_run_chimerax.setEnabled(False)
            return

        centroids = {cid: np.mean([r['coord'] for r in data], axis=0) for cid, data in chains.items()}
        chain_ids = list(chains.keys())
        
        Z_MIN, Z_MAX, XY_LIMIT, N_SEARCH = 4.6, 5.0, 3.0, 6
        adjacency = {cid: [] for cid in chain_ids}
        
        for id_a in chain_ids:
            center_a = centroids[id_a]
            dists = [(np.linalg.norm(center_a - centroids[id_b]), id_b) for id_b in chain_ids if id_a != id_b]
            dists.sort(key=lambda x: x[0])
            closest = [x[1] for x in dists[:N_SEARCH]]
            
            for id_b in closest:
                res_map_a = {r['id']: r['coord'] for r in chains[id_a]}
                res_map_b = {r['id']: r['coord'] for r in chains[id_b]}
                common_ids = set(res_map_a.keys()).intersection(set(res_map_b.keys()))
                
                if len(common_ids) >= 3:
                    z_diffs = []
                    is_stacked = True
                    for rid in common_ids:
                        pa = res_map_a[rid]; pb = res_map_b[rid]
                        dx, dy, dz = pb[0]-pa[0], pb[1]-pa[1], pb[2]-pa[2]
                        if math.sqrt(dx*dx + dy*dy) > XY_LIMIT:
                            is_stacked = False
                            break
                        z_diffs.append(dz)
                        
                    if is_stacked and z_diffs:
                        avg_dz = np.mean(z_diffs)
                        if Z_MIN <= abs(avg_dz) <= Z_MAX and np.std(z_diffs) <= 1.5:
                            if id_b not in adjacency[id_a]:
                                adjacency[id_a].append(id_b)
                                adjacency[id_b].append(id_a)
                                
        protofilaments = []
        visited = set()
        for cid in chain_ids:
            if cid not in visited:
                comp = []
                stack = [cid]
                visited.add(cid)
                while stack:
                    curr = stack.pop()
                    comp.append(curr)
                    for nxt in adjacency[curr]:
                        if nxt not in visited:
                            visited.add(nxt)
                            stack.append(nxt)
                protofilaments.append(comp)

        max_layers = max([len(pf) for pf in protofilaments]) if protofilaments else 0

        # Enable Logic based on detected layers
        if max_layers <= 1:
            btn_run.setEnabled(True)
            btn_run_chimerax.setEnabled(True)
        else:
            btn_run.setEnabled(False)
            btn_run_chimerax.setEnabled(True)

    # Attach live-checking logic
    entry_pdb.textChanged.connect(check_pdb_state)
    check_pdb_state()

