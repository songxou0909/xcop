        if not model:
            show_error_message("Please select a Model Name.")
            return

        path = os.path.join(folder, model)
        if not os.path.isdir(path):
            show_error_message(f"Path not found: {path}")
            return

        pattern = re.compile(r"run(\d+)_it(\d+)_.*\.mrcs")
        candidates = []
        try:
            for f in os.listdir(path):
                m = pattern.match(f)
                if m:
                    run_num = int(m.group(1))
                    it_num = int(m.group(2))
                    candidates.append((run_num, it_num, f))
        except OSError:
            pass

        if not candidates:
            show_error_message("No runX_itY_*.mrcs files found")
