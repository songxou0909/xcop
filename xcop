    def update_run_number(model_name):
        folder_path = entry_folder.text().strip()
        if not folder_path or not model_name:
            return
            
        target_path = os.path.join(folder_path, model_name)
        if not os.path.isdir(target_path):
            return
            
        max_run = 0
        pattern = re.compile(r"run(\d+)_")
        try:
            for f in os.listdir(target_path):
                m = pattern.match(f)
                if m:
                    run_num = int(m.group(1))
                    if run_num > max_run:
                        max_run = run_num
        except OSError:
            pass
            
        if max_run > 0:
            entry_run.setText(str(max_run))

