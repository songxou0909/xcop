        def on_error(err_msg):
            QMessageBox.critical(win, "Error", f"An error occurred: {err_msg}")

        # 5. Connect Signals
        win.signals.finished.connect(on_finished)
        win.signals.error.connect(on_error)

        # 6. Start Thread (Pass the worker function and the arguments)
        if 'app' in globals() and app:
            app.output_text.setText(f"Command Sent\n\n{app.output_text.toPlainText()}")

        t = threading.Thread(target=worker, args=(cmds,))
        t.start()
        
        QMessageBox.information(win, "Started", "Jobs are running in the background...\nReminder will pop up when finishes")

