        lbl = QLabel(f"{sw.capitalize()}:")
        lbl.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
        grid.addWidget(lbl, row, 0)
        
        combo = QComboBox()
        combo.addItems(modules)
        
        # Try to set the active selection to what is currently written in the script
        curr_val = current_versions.get(sw, "")
        if curr_val in modules:
            combo.setCurrentText(curr_val)
        elif curr_val and not curr_val.startswith("Not Found"):
            # If current version exists but wasn't detected by ml avail, inject it
            combo.insertItem(0, curr_val)
            combo.setCurrentText(curr_val)
            
        grid.addWidget(combo, row, 1)
        combos[sw] = combo
        row += 1
        
    def save_settings():
        selections = {sw: combo.currentText() for sw, combo in combos.items()}
        
        # Modify the script file itself
        script_path = os.path.abspath(__file__)
        if os.path.exists(script_path):
            try:
                with open(script_path, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                val_relion = "" if selections['relion'].startswith("Not Found") else selections['relion']
                val_xmipp = "" if selections['xmipp'].startswith("Not Found") else selections['xmipp']
                val_servalcat = "" if selections['servalcat'].startswith("Not Found") else selections['servalcat']
                val_phenix = "" if selections['phenix'].startswith("Not Found") else selections['phenix']
                val_chimera = "" if selections['chimera'].startswith("Not Found") else selections['chimera']

                # Overwrite variables in the file using Regex
                content = re.sub(r'^RELION_VER\s*=\s*["\'].*?["\']', f'RELION_VER = "{val_relion}"', content, flags=re.MULTILINE)
                content = re.sub(r'^XMIPP_VER\s*=\s*["\'].*?["\']', f'XMIPP_VER = "{val_xmipp}"', content, flags=re.MULTILINE)
                content = re.sub(r'^SERVALCAT_VER\s*=\s*["\'].*?["\']', f'SERVALCAT_VER = "{val_servalcat}"', content, flags=re.MULTILINE)
                content = re.sub(r'^PHENIX_VER\s*=\s*["\'].*?["\']', f'PHENIX_VER = "{val_phenix}"', content, flags=re.MULTILINE)
                content = re.sub(r'^CHIMERA_VER\s*=\s*["\'].*?["\']', f'CHIMERA_VER = "{val_chimera}"', content, flags=re.MULTILINE)
                    
                with open(script_path, 'w', encoding='utf-8') as f:
                    f.write(content)
                    
                # Dynamically update the running variables in memory
                global RELION_VER, XMIPP_VER, SERVALCAT_VER, PHENIX_VER, CHIMERA_VER
                RELION_VER = val_relion
                XMIPP_VER = val_xmipp
                SERVALCAT_VER = val_servalcat
                PHENIX_VER = val_phenix
                CHIMERA_VER = val_chimera

                if 'app' in globals() and app:
                    app.output_text.setText("Settings saved successfully.\nYour xcop program has been updated permanently.")
            except Exception as e:
                if 'app' in globals() and app:
                    app.output_text.setText(f"Error updating script: {e}")
        else:
            if 'app' in globals() and app:
