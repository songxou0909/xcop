def open_input_window_separate_movies():
    global last_separate_movies_inputs
    input_window = QWidget()
    input_window.setWindowTitle("Separate Movies")
    center_window(input_window, 400, 150, "separate_movies")
    toplevel_windows.append(input_window)
    
    if 'app' in globals() and app:
        input_window.setStyleSheet(app.styleSheet())

    layout = QVBoxLayout(input_window)
    layout.setSpacing(15)

    # Automated Separation logic
    ipc_file = os.path.join(os.getcwd(), f".xcop_ipc_{os.getpid()}.txt")
    ready_file = os.path.join(os.getcwd(), f".xcop_ready_{os.getpid()}.txt")
    
    def run_automated_separation():
        # Prevent double clicks and update UI immediately
        btn_auto_sep.setText("Loading...")
        btn_auto_sep.setEnabled(False)
        btn_auto_sep.repaint()
        QApplication.processEvents()
        
        if os.path.exists(ready_file):
            try: os.remove(ready_file)
            except: pass

        import glob
        auto_jpg_dir = os.path.join(base_path, "xcop_savings", "AutoJPG")
        auto_jpg_script = os.path.join(auto_jpg_dir, "AutoJPG.py")
        if not os.path.exists(auto_jpg_script):
            show_error_message(f"AutoJPG.py not found in {auto_jpg_dir}")
            btn_auto_sep.setText("Automated Separation")
            btn_auto_sep.setEnabled(True)
            return
        
        pth_files = glob.glob(os.path.join(auto_jpg_dir, "*.pth"))
        model_arg = pth_files[0] if len(pth_files) == 1 else ""
        
        cmd = [sys.executable, auto_jpg_script]
        if model_arg:
            cmd.extend(["--model-path", model_arg])
        cmd.extend(["--ipc-file", ipc_file, "--parent-pid", str(os.getpid()), "--ready-file", ready_file])
        
        subprocess.Popen(cmd)
        
        # Setup a fast-polling timer to listen for the ready signal from AutoJPG.py
        input_window.ready_timer = QTimer()
        input_window.ready_attempts = 0
        def check_ready():
            input_window.ready_attempts += 1
            # Unlock if file is found OR if 10 seconds pass (fail-safe)
            if os.path.exists(ready_file) or input_window.ready_attempts > 100:
                try: os.remove(ready_file)
                except: pass
                btn_auto_sep.setText("Automated Separation")
                btn_auto_sep.setEnabled(True)
                input_window.ready_timer.stop()
                
        input_window.ready_timer.timeout.connect(check_ready)
        input_window.ready_timer.start(200) # Check 5 times per second
        
        input_window.ipc_timer = QTimer()
        def check_ipc():
            if os.path.exists(ipc_file):
                try:
                    with open(ipc_file, "r") as f:
                        res = f.read().strip()
                    os.remove(ipc_file)
                    input_window.ipc_timer.stop()
                    
                    if res:
                        # Feed the path into the newly created secondary window
                        open_filelist_separation_window(auto_jpg_path=res)
                    
                    # Pop the window back to the front
                    input_window.setWindowState(input_window.windowState() & ~Qt.WindowState.WindowMinimized | Qt.WindowState.WindowActive)
                    input_window.showNormal()
                    input_window.raise_()
                    input_window.activateWindow()
                    
                except Exception:
                    pass
        input_window.ipc_timer.timeout.connect(check_ipc)
        input_window.ipc_timer.start(1000)

    # First Button: Automated Separation
    btn_auto_sep = QPushButton("Automated Separation")
    btn_auto_sep.setStyleSheet("background-color: #98c379; color: #1e1e1e; font-weight: bold; padding: 10px;")
    btn_auto_sep.clicked.connect(run_automated_separation)
    layout.addWidget(btn_auto_sep)

    # Second Button: Filelist Separation Window
    btn_filelist = QPushButton("Use Filelist to Separate Movies")
    btn_filelist.setStyleSheet("padding: 10px;")
    btn_filelist.clicked.connect(lambda: open_filelist_separation_window())
    layout.addWidget(btn_filelist)

    input_window.show()

# Function to open a new window for "Calculate Dose per Frame" inputs
def open_input_window_dose_calculation():
    global last_movie_frames
    input_window = QWidget()
    input_window.setWindowTitle("Enter Parameters for Dose Calculation")
    center_window(input_window, 450, 300, "dose_calculation")
    toplevel_windows.append(input_window)

    if 'app' in globals() and app:
        input_window.setStyleSheet(app.styleSheet())

    layout = QGridLayout(input_window)

    labels = ["Total dose (e/Å^2):", "Number of frames:"]
    entries = []

    for i, label_text in enumerate(labels):
        lbl = QLabel(label_text)
        layout.addWidget(lbl, i, 0)
        
        entry = QLineEdit()
        if label_text == "Total dose (e/Å^2):":
            entry.setText("40")
        elif label_text == "Number of frames:" and last_movie_frames:
            entry.setText(last_movie_frames)
        
        layout.addWidget(entry, i, 1)
        entries.append(entry)

    def submit_inputs():
        try:
            total_dose = float(entries[0].text())
            num_frames = int(entries[1].text())
            if total_dose <= 0 or num_frames <= 0:
                raise ValueError("Inputs must be positive numbers.")
        except ValueError as e:
            show_error_message(f"Invalid input: {str(e)}")
            return

        global last_movie_frames
        last_movie_frames = str(num_frames)
        save_last_inputs()

        results = []
        excluded_results = []
        for eer in range(10, 41):
            fractions_before = num_frames / eer
            fractions_after = math.floor(fractions_before)
            signal_loss = num_frames-(fractions_after*eer)
            dose_per_frame = total_dose / fractions_after if fractions_after > 0 else 0
            result = {
                'eer': eer,
                'fractions_before': fractions_before,
                'fractions_after': fractions_after,
                'dose_per_frame': dose_per_frame,
                'signal_loss': signal_loss
            }
            if 0.5 <= dose_per_frame <= 1.25:
                results.append(result)
            else:
                excluded_results.append(result)

        results.sort(key=lambda x: (x['signal_loss'], -x['eer']))

        output = "Frames| EER Frac| Dose/Frame| Frame Loss\n"
        output += "-" * 42 + "\n"
        for result in results[:5]:
            output += (f"{num_frames} | {result['eer']} |"
                       f" {result['dose_per_frame']:.8f} | {result['signal_loss']}\n")
        
        if excluded_results:
            output += "\nExcluded Dose/frames (fall outside 0.5 ~ 1.25 e/Å²)\n"
            output += "-" * 42 + "\n"
            for result in excluded_results:
                output += (f"{num_frames} | {result['eer']} |"
                           f" {result['dose_per_frame']:.8f} | {result['signal_loss']}\n")
        
        if 'app' in globals() and app:
            app.output_text.setText(output)
        close_toplevel_windows()

    submit_button = QPushButton("Submit")
    submit_button.clicked.connect(submit_inputs)
    layout.addWidget(submit_button, len(labels), 0, 1, 2)
    
    input_window.show()

