    def run_focus_map_chimerax():
        pdb_path = entry_pdb.text().strip()
        mrc_path = entry_mrc.text().strip()
        target_dir = entry_dir.text().strip()
        
        pdb_basename = os.path.basename(pdb_path)
        mrc_basename = os.path.basename(mrc_path)
        pdb_path_base = os.path.splitext(pdb_basename)[0]

        if not all([pdb_path, mrc_path, target_dir]):
            QMessageBox.warning(win, "Error", "Please fill in all fields.")
            return
        
        # --- NEW LOGIC: Detect Protofilaments (Handles 1-layer & Multi-layer seamlessly) ---
        import numpy as np
        import math
        
        chains = {}
        with open(pdb_path, 'r') as f:
            for line in f:
                if line.startswith("ATOM") and line[12:16].strip() == "CA":
                    chain_id = line[20:22].strip()
                    res_id = line[22:27].strip()
                    try:
                        x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])
                        if chain_id not in chains: chains[chain_id] = []
                        chains[chain_id].append({'id': res_id, 'coord': np.array([x,y,z])})
                    except: pass
                    
        if not chains:
            QMessageBox.warning(win, "Error", "Could not detect any CA atoms in the PDB file.")
            return
            
        centroids = {cid: np.mean([r['coord'] for r in data], axis=0) for cid, data in chains.items()}
        chain_ids = list(chains.keys())
        
        Z_MIN, Z_MAX, XY_LIMIT, N_SEARCH = 4.6, 5.0, 3.0, 6
        adjacency = {cid: [] for cid in chain_ids}
        
        for id_a in chain_ids:
            center_a = centroids[id_a]
            dists = [(np.linalg.norm(center_a - centroids[id_b]), id_b) for id_b in chain_ids if id_a != id_b]
            dists.sort(key=lambda x: x[0])
            closest = [x[1] for x in dists[:N_SEARCH]]
            
            for id_b in closest:
                res_map_a = {r['id']: r['coord'] for r in chains[id_a]}
                res_map_b = {r['id']: r['coord'] for r in chains[id_b]}
                common_ids = set(res_map_a.keys()).intersection(set(res_map_b.keys()))
                
                if len(common_ids) >= 3:
                    z_diffs = []
                    is_stacked = True
                    for rid in common_ids:
                        pa = res_map_a[rid]; pb = res_map_b[rid]
                        dx, dy, dz = pb[0]-pa[0], pb[1]-pa[1], pb[2]-pa[2]
                        if math.sqrt(dx*dx + dy*dy) > XY_LIMIT:
                            is_stacked = False
                            break
                        z_diffs.append(dz)
                        
                    if is_stacked and z_diffs:
                        avg_dz = np.mean(z_diffs)
                        if Z_MIN <= abs(avg_dz) <= Z_MAX and np.std(z_diffs) <= 1.5:
                            if id_b not in adjacency[id_a]:
                                adjacency[id_a].append(id_b)
                                adjacency[id_b].append(id_a)
                                
        protofilaments = []
        visited = set()
        for cid in chain_ids:
            if cid not in visited:
                comp = []
                stack = [cid]
                visited.add(cid)
                while stack:
                    curr = stack.pop()
                    comp.append(curr)
                    for nxt in adjacency[curr]:
                        if nxt not in visited:
                            visited.add(nxt)
                            stack.append(nxt)
                protofilaments.append(comp)
                
        protofilaments.sort(key=len, reverse=True)
        # --- END NEW LOGIC ---

        n_proto = len(protofilaments)
        
        if n_proto == 0:
            QMessageBox.warning(win, "Error", "Could not group any chains into protofilaments.")
            return

        script_filename = "chimerax_focus_script.cxc"
        script_full_path = os.path.join(target_dir, script_filename).replace("\\", "/")
        
        colors_list = ["red", "orange red", "orange", "yellow", "lime", "forest green", "cyan", "light sea green", "blue", "cornflower blue", "medium blue", "purple", "hot pink", "magenta", "white", "light gray", "gray", "dark gray", "dim gray", "black"]
        
        color_commands = ""
        save_loop_commands = ""
        for i, pf in enumerate(protofilaments):
            # Generate color command mapped to protofilament group
            chains_str = ",".join(pf)
            color_name = colors_list[i % len(colors_list)]
            color_commands += f'color /{chains_str} {color_name}\n'
            
            # Generate local directory save command
            model_id = i + 1
            file_name = f"{pdb_path_base}_protofilament{i+1}.mrc"
            save_loop_commands += f'save "{file_name}" models #3.{model_id}\n'

        script_content = f"""open "{pdb_basename}" id #1
open "{mrc_basename}" id #2
{color_commands}color zone #2 near #1 distance 1.7
volume splitbyzone #2
{save_loop_commands}
"""
        try:
            with open(script_full_path, "w") as f:
                f.write(script_content)
                
            write_to_log(f"Generated ChimeraX script for split density: {script_full_path}")
            
            if 'app' in globals() and app:
                app.output_text.setPlainText(f"ChimeraX Script Generated!\n\nPlease drag and drop the following file into your local ChimeraX:\n{script_full_path}\n\nMake sure {pdb_basename} and {mrc_basename} are in the same local folder!")
                
            QMessageBox.information(win, "Success", f"ChimeraX script exported to:\n{script_full_path}\n\nDrag this .cxc file into ChimeraX to split your maps locally.\nMake sure your map and PDB are in the same folder.")
            win.close()
