# Function to center a window on the screen or use saved size
def center_window(window, width, height, window_type):
    global window_sizes
    # In Qt, ensure geometry is up to date usually happens automatically, but we can process events if needed
    
    user_sizes = window_sizes.get(user_name, {})
    saved_size = user_sizes.get(window_type)
    
    # Screen Dimensions
    screen_geometry = QApplication.primaryScreen().availableGeometry()
    
    if saved_size:
        width, height = saved_size
    
    x = (screen_geometry.width() - width) // 2
    y = (screen_geometry.height() - height) // 2
    
    window.setGeometry(x, y, width, height)

    # Attach event filter to handle saving window size (replaces Tk bind)
    # We store the filter on the window to prevent garbage collection
    window._resize_filter = ResizeEventFilter(window_type, window)
    window.installEventFilter(window._resize_filter)

