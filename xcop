                "Resolution of your PostProcess Map<br>"
                "This is optional, it is just a mark on the final files you generate<br>"
            )
            
            # Apply to both Label and Entry
            label_widget.setToolTip(tt_reso)
            entry.setToolTip(tt_reso)

        entry.setFixedWidth(100)
        layout.addWidget(entry, row, 1)
        param_entries.append(entry)
    
    # --- Checkboxes for Conversion ---
    
    chk_pdf = QCheckBox("Convert to PDF")
    chk_pdf.setChecked(True) # Default to Checked
    chk_pdf.setToolTip("Uses Ghostscript (ps2pdf) to convert .ps -> .pdf")
    layout.addWidget(chk_pdf, 5, 0, 1, 2) # Span 2 columns

    chk_svg = QCheckBox("Convert to SVG")
    chk_svg.setChecked(True) # Default to Checked
    chk_svg.setToolTip("Uses Poppler (pdftocairo) to convert .ps -> .pdf -> .svg")
    layout.addWidget(chk_svg, 5, 2, 1, 1)

    # New Checkbox for deletion
    chk_delete = QCheckBox("Delete Intermediate Files")
    chk_delete.setChecked(False) # Default to False
    chk_delete.setToolTip("If checked, the folder containing intermediate files will be deleted immediately after processing")
    layout.addWidget(chk_delete, 6, 0, 1, 3)

    # --- Logic ---
    def run_process():
        full_pdb_path = pdb_entry.text().strip()
        
        # 1. Capture Checkbox States (Must be done in Main Thread)
        do_convert_pdf = chk_pdf.isChecked()
        do_convert_svg = chk_svg.isChecked()
        do_delete_intermediate = chk_delete.isChecked()

        if not full_pdb_path:
            show_error_message("Please select a PDB file first.")
            return
        
        if not os.path.exists(full_pdb_path):
            show_error_message("Selected PDB file does not exist.")
            return

        # Define Paths
        pdb_dir = os.path.dirname(os.path.abspath(full_pdb_path))
        pdb_filename = os.path.basename(full_pdb_path)
        pdb_root = os.path.splitext(pdb_filename)[0]
        resource_dir = os.path.join(base_path, "xcop_savings", "AutoIllustrate")
        
        if not os.path.exists(resource_dir):
            show_error_message(f"Resource folder not found:\n{resource_dir}")
            return

        # Copy Resources
        try:
            for item in os.listdir(resource_dir):
                s = os.path.join(resource_dir, item)
                d = os.path.join(pdb_dir, item)
                if os.path.isfile(s):
                    shutil.copy2(s, d)
        except Exception as e:
            show_error_message(f"Failed to copy resources: {e}")
            return

        # 3. Modify autoillustrate.com in the target directory
        script_path = os.path.join(pdb_dir, "autoillustrate.com")
        if not os.path.exists(script_path):
            show_error_message(f"autoillustrate.com missing in target after copy.\nChecked: {script_path}")
            return

        try:
            # Get Params
            res_val = param_entries[0].text()
            ph_val = param_entries[1].text()
            rotx_val = param_entries[2].text()
            rotz_val = param_entries[3].text()
            
            # Prepare strings for replacement
            # Note: Ensure path ends with / as per original script logic if needed, 
            # though usually csh handles paths fine without it.
            clean_pdb_dir = pdb_dir if pdb_dir.endswith(os.sep) else pdb_dir + os.sep
            
            new_lines = []
            with open(script_path, "r") as f:
                lines = f.readlines()
                
            for line in lines:
                stripped = line.strip()
                if stripped.startswith("set exedir"):
                    new_lines.append(f"set exedir = '{clean_pdb_dir}'\n")
                elif stripped.startswith("set pdbin"):
                    new_lines.append(f"set pdbin = {pdb_filename}\n")
                elif stripped.startswith("set title1"):
                    new_lines.append(f"set title1 = '{pdb_root}'\n")
                elif stripped.startswith("set reso"):
                    new_lines.append(f"set reso = {res_val}\n")
                elif stripped.startswith("set pHvalu"):
                    new_lines.append(f"set pHvalu = {ph_val}\n")
                elif stripped.startswith("set rotx"):
                    new_lines.append(f"set rotx = {rotx_val}\n")
                elif stripped.startswith("set rotz"):
                    new_lines.append(f"set rotz = {rotz_val}\n")
                else:
                    new_lines.append(line)

            with open(script_path, "w") as f:
                f.writelines(new_lines)

        except Exception as e:
            show_error_message(f"Failed to modify script: {e}")
            return

        # 4. Execute
        # ---------------------------------------------------------
        # EXECUTION THREAD
        # ---------------------------------------------------------
        def execution_thread():
            try:
                # A. Run the script
                cmd = (
                    f"cd '{pdb_dir}' && "
                    f"chmod 755 pdbclean_v02 a* isolatefibrilasu_v04 rotxz && "
                    f"./autoillustrate.com"
                )

                write_to_log(cmd)
                subprocess.run(cmd, shell=True, executable="/bin/bash", check=True)

                # B. Conversion Logic
                if do_convert_pdf or do_convert_svg:
                    has_ps2pdf = shutil.which("ps2pdf") is not None
                    has_pdftocairo = shutil.which("pdftocairo") is not None
                    
                    if has_ps2pdf:
                        for filename in os.listdir(pdb_dir):
                            if filename.endswith(".ps"):
                                try:
                                    base_name = os.path.splitext(filename)[0]
                                    ps_path = os.path.join(pdb_dir, filename)
                                    pdf_path = os.path.join(pdb_dir, f"{base_name}.pdf")
                                    svg_path = os.path.join(pdb_dir, f"{base_name}.svg")

                                    # Use A2 size (quarter of A0) to eliminate white space
                                    # Prepress keeps the scale bar intact (no downsampling)
                                    cmd_pdf = (
                                        f"ps2pdf -dPDFSETTINGS=/prepress -sPAPERSIZE=a2 -dAutoRotatePages=/None "
                                        f"'{ps_path}' '{pdf_path}'"
                                    )
                                    subprocess.run(cmd_pdf, shell=True, check=True)
                                    
                                    # Convert PDF -> SVG
                                    if do_convert_svg:
                                        if has_pdftocairo:
                                            subprocess.run(f"pdftocairo -svg '{pdf_path}' '{svg_path}'", 
                                                         shell=True, check=True)
                                            print(f"Generated SVG: {base_name}.svg")
                                        else:
                                            print("Skipping SVG: pdftocairo not found.")

                                    # Cleanup PDF
                                    if not do_convert_pdf and os.path.exists(pdf_path):
                                        os.remove(pdf_path)
                                    else:
                                        print(f"Generated PDF: {base_name}.pdf")

                                except Exception as e:
                                    print(f"Conversion error for {filename}: {e}")
                    else:
                        print("Skipping conversion: ps2pdf not found.")

                # C. Cleanup / Move Files
                import uuid
                unique_id = uuid.uuid4().hex[:8]
                folder_name = f"Intermediate_files_{pdb_root}_{unique_id}"
                others_dir = os.path.join(pdb_dir, folder_name)
                
                os.makedirs(others_dir, exist_ok=True)

                # Define specific intermediate files to move
                intermediate_files = [
                    f"{pdb_root}.csv", f"{pdb_root}_.pdb", f"{pdb_root}_asu.csv",
                    f"{pdb_root}_pdbcur.pdb", f"{pdb_root}_pdbcur_asu.pdb",
                    f"{pdb_root}_pdbcur_unit.pdb", "aburied.pdb",
                    "accessiblesurfacearea_v07.2u.log", "aspkluge7.2.pdb",
                    "asulist.log", "autoschematic.log", "buried.log",
                    "chainlist.log", "hbonds.pml", "hbunsatisfied.pdb",
                    "isolatefibrilasu.log", "pctsideburied.pdb", "rotxz.log",
                    "sasafolded.pdb", "sasaisolated.pdb", "sfekluge7.2.pdb",
                    "sfekluge7.2.sumperresid.pdb", "sfesasathres20.pdb","accessiblesurfacearea_v07.2u",
                    "autoillustrate.com","autoschematic.com","autoschematic171","convert.com",
                    "isolatefibrilasu_v04","pdbclean_v02","rotxz","rotxz.com"
                ]

                for item in intermediate_files:
                    item_path = os.path.join(pdb_dir, item)
                    if os.path.exists(item_path):
                        try:
                            shutil.move(item_path, os.path.join(others_dir, item))
                        except Exception as move_err:
                            print(f"Skipped moving {item}: {move_err}")

                # D. Final Deletion (If requested)
                if do_delete_intermediate:
                    try:
                        shutil.rmtree(others_dir)
                        print(f"Deleted intermediate folder: {others_dir}")
                    except Exception as del_err:
                        print(f"Failed to delete intermediate folder: {del_err}")

            except subprocess.CalledProcessError as e:
                err_msg = f"Script failed:\n{e}"
                QTimer.singleShot(0, lambda: show_error_message(err_msg))
            except Exception as e:
                err_msg = f"Error:\n{e}"
                QTimer.singleShot(0, lambda: show_error_message(err_msg))

        if 'app' in globals() and app:
            app.output_text.setText(f"Command Sent\n\nProcess Complete!\n\nThe .ps files can be opened in\n\nAdobe Illustrator or Adobe Photoshop")
            
        threading.Thread(target=execution_thread, daemon=True).start()
        win.close()
        
    # Run Button (Moved to Row 7 to accommodate the new checkbox)
    btn_run = QPushButton("Run")
    btn_run.clicked.connect(run_process)
    layout.addWidget(btn_run, 7, 0, 1, 3)
    
    win.show()

